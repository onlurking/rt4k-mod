{
  "name": "rt4k-mod-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "cli": "bun run --filter @rt4k-mod/cli start",
    "cli:dev": "bun run --filter @rt4k-mod/cli start",
    "cli:test": "bun run --filter @rt4k-mod/cli test",
    "cli:build": "bun run --filter @rt4k-mod/cli build",
    "web": "bun run --filter @rt4k-mod/webapp dev",
    "web:dev": "bun run --filter @rt4k-mod/webapp dev",
    "web:test": "bun run --filter @rt4k-mod/webapp test",
    "web:build": "bun run --filter @rt4k-mod/webapp build"
  }
}
